{
  "name": "dsh-todo",
  "version": "0.2.0",
  "type": "module",
  "description": "A shared plan board for you and the agent in the DeepSeek Harness right sidebar: stages, dependencies, due dates, and a passive reminder of where the work stands.",
  "license": "MIT",
  "author": "GUGUQ1",
  "repository": {
    "type": "git",
    "url": "https://github.com/GUGUQ1/dsh-todo.git"
  },
  "homepage": "https://github.com/GUGUQ1/dsh-todo#readme",
  "bugs": {
    "url": "https://github.com/GUGUQ1/dsh-todo/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "todo",
    "todo-list",
    "plan",
    "sidebar"
  ],
  "scripts": {
    "test": "node tools/plan-store-test.mjs && node tools/board-test.mjs && node tools/command-test.mjs && node tools/tool-test.mjs && node tools/smoke-client.mjs",
    "check-session": "node tools/session-check.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "host",
    "assets",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.2-rc.5 <0.3.0-0"
  }
}
